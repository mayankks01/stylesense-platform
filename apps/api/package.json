    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "express": "^5.1.0", "helmet": "^8.1.0", "pg": "^8.16.3", "zod": "^4.1.12" },
  "devDependencies": { "@types/express": "^5.0.3", "@types/node": "^22.18.0", "@types/pg": "^8.15.5", "tsx": "^4.20.6" }
}
