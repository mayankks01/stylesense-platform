{
  "name": "@stylesense/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "node --env-file=.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env ../../node_modules/prisma/build/index.js migrate deploy",
    "user:create": "tsx --env-file=.env src/bootstrap.ts",
    "test:integration": "tsx --env-file=.env --test test/integration/run.ts test/integration/email.ts test/integration/assistance.ts",
    "test:console": "tsx --env-file=.env --test test/integration/console.ts",
    "evaluate:replies": "tsx --env-file=.env src/ai/evaluate.ts",
    "examples:emails": "tsx src/email/examples.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "svix": "^2.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "playwright": "^1.58.2",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "vite": "^7.3.7"
  }
}
