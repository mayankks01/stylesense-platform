NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Keep this synchronized with the root .env database settings.
DATABASE_URL=postgresql://stylesense:stylesense_local_only@127.0.0.1:55433/stylesense
APP_ORIGIN=http://127.0.0.1:5180
# Development only; opt in to explicitly labelled event simulations.
ALLOW_SIMULATED_EVENTS=false
# For the one-time account creation command. Remove the password afterwards.
# BOOTSTRAP_EMAIL=you@example.com
# BOOTSTRAP_NAME=Your Name
# BOOTSTRAP_PASSWORD=choose-a-unique-password-of-at-least-12-characters

# Step 4: mock is explicit and never contacts an email provider.
EMAIL_MODE=mock
EMAIL_MOCK_FAILURE=none
EMAIL_FROM=StyleSense AI <onboarding@resend.dev>
EMAIL_SENDER_NAME=StyleSense team
# EMAIL_PROPOSED_TIME_WINDOW=next week
PUBLIC_BASE_URL=http://127.0.0.1:4100
# For Resend test-recipient mode, configure these privately and use a reachable HTTPS origin above.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Step 6: local fixtures and rule-based classification, not real research or an LLM.
AI_MODE=mock
# For live discovery/reply analysis, set AI_MODE=openai and configure privately:
# OPENAI_API_KEY=
# TAVILY_API_KEY=
# AI_MODEL=your-enabled-responses-function-calling-model
